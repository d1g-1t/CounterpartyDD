# ---- Compose / порты (хост) -----------------------------------------------
COMPOSE_PROJECT_NAME=counterpartydd
API_HOST_PORT=20300
POSTGRES_HOST_PORT=20301
REDIS_HOST_PORT=20302

# ---- Postgres / Redis -----------------------------------------------------
POSTGRES_USER=cdd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=counterparty_dd

# ---- Приложение (сеть compose: postgres/redis) ----------------------------
CDD_ENV=dev
CDD_DATABASE_URL=postgresql+asyncpg://cdd:change-me@postgres:5432/counterparty_dd
CDD_REDIS_URL=redis://redis:6379/0
CDD_TOKEN_SECRET=change-me-to-a-random-string-of-32-plus-chars
CDD_AUDIT_SECRET=change-me-to-another-random-string-of-32-chars
CDD_HIGH_RISK_COUNTRIES=[]
CDD_CORS_ORIGINS=[]

# ---- Тесты (make test) -----------------------------------------------------
CDD_TEST_DATABASE_URL=postgresql+asyncpg://cdd:change-me@postgres:5432/counterparty_dd_test
CDD_TEST_REDIS_URL=redis://redis:6379/15
